{
  "schema_version": 1,
  "experiment": "sharegpt40-ten-baselines-2026-11-13",
  "prepared_on": "2026-11-13",
  "dataset": {
    "name": "ShareGPT40",
    "prompt_groups": [
      0,
      128,
      256,
      512,
      1024
    ],
    "prompts_per_group": 10,
    "prompt_ids": "prompt_{group}_{01..10}.txt",
    "note": "Ours 14B/24B/32B and Galaxy 14B cover groups 0/128/256/512/1024 (10 prompts each). Other full baselines cover groups 128/256/512/1024; Jupiter 24B 1024 group has 6 PASS observations."
  },
  "models": {
    "14b": "Qwen3-14B-Q4_K_M.gguf",
    "32b": "Qwen3-32B-Q4_K_M.gguf",
    "24b": "Mistral-Small-3.2-24B-Q6_K.gguf"
  },
  "hardware": {
    "pc_cpu": "Intel Core Ultra 7 155H",
    "pc_gpu": "NVIDIA RTX 4050 Laptop GPU 6 GiB",
    "phone_soc": "Snapdragon 8 Elite"
  },
  "runtime_paths": {
    "model_dir": "${MODEL_DIR}",
    "prompt_dir": "${PROMPT_DIR}",
    "rpc_endpoint": "${RPC_ENDPOINT}"
  },
  "runs": [
    {
      "id": "prima-14b",
      "framework": "prima.cpp",
      "model": "14b",
      "context": 2048,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS",
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      }
    },
    {
      "id": "prima-32b",
      "framework": "prima.cpp",
      "model": "32b",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS"
    },
    {
      "id": "jupiter-14b",
      "framework": "jupiter",
      "model": "14b",
      "method": "Sequence DP",
      "pc_layers": 24,
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "graph_prebuild": true,
      "window": 2,
      "bench_repeats": 1
    },
    {
      "id": "jupiter-32b",
      "framework": "jupiter",
      "model": "32b",
      "method": "Sequence DP",
      "pc_layers": 52,
      "cpu_layers": 40,
      "pc_gpu_layers": 12,
      "phone_layers": 12,
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "graph_prebuild": true,
      "window": 2,
      "bench_repeats": 1,
      "max_rounds": 1,
      "min_chunk": 96,
      "max_chunk": 128,
      "memory_safety_percent": 5
    },
    {
      "id": "galaxy-14b",
      "framework": "galaxy",
      "model": "14b",
      "mode": "Galaxy",
      "transport": "RANK_LOCAL",
      "galaxy2_layers": 1,
      "collective_tile_tokens": 256,
      "context": 2048,
      "batch": 512,
      "ubatch": 256,
      "threads": 8,
      "final_layer_sp": false,
      "supplemental_group0_config": "runs/galaxy-14b-group0/run-config.json",
      "supplemental_group0_details": "runs/galaxy-14b-group0/per-prompt-details.csv",
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      }
    },
    {
      "id": "ours-14b-server-plan",
      "framework": "ours",
      "model": "14b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-14b-server-plan/run-config.json",
      "layout": "G11,P5,G11,P5,G8",
      "layout_reported": true,
      "layout_source": "user-confirmed alongside SERVER_PROBE logs",
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-14b-server-plan/per-prompt-details.csv"
    },
    {
      "id": "prima-24b",
      "framework": "prima.cpp",
      "model": "24b",
      "model_family": "Mistral Small 3.2",
      "quantization": "Q6_K",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS",
      "run_config": "runs/prima-24b/run-config.json",
      "observed_planner": {
        "k": 1,
        "W": 40,
        "pc_layers": 19,
        "pc_gpu_layers": 9,
        "phone_layers": 21,
        "phone_gpu_layers": 0
      },
      "runs": 40
    },
    {
      "id": "ours-32b-server-plan",
      "framework": "ours",
      "model": "32b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-32b-server-plan/run-config.json",
      "layout": "G7,P4,G7,P4,G8,P5,G7,P4,G7,P4,G7",
      "layout_reported": true,
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-32b-server-plan/per-prompt-details.csv",
      "layout_source": "user-confirmed follow-up to 2026-11-17 SERVER_PROBE data"
    },
    {
      "id": "ours-24b-server-plan",
      "framework": "ours",
      "model": "24b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-24b-server-plan/run-config.json",
      "layout": "G5,P3,G5,P3,G6,P3,G5,P4,G6",
      "layout_reported": true,
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-24b-server-plan/per-prompt-details.csv",
      "layout_source": "user-confirmed follow-up to 2026-11-17 SERVER_PROBE data"
    },
    {
      "id": "jupiter-24b",
      "framework": "jupiter",
      "model": "24b",
      "method": "Sequence DP",
      "run_config": "runs/jupiter-24b/run-config.json",
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "pc_layers": 32,
      "cpu_layers": 24,
      "graph_prebuild": false,
      "min_chunk": 96,
      "max_chunk": 128,
      "bench_repeats": 1,
      "expected_prompts": 40,
      "observed_passes": 36,
      "complete": false
    }
  ],
  "measurements": {
    "prefill_ms": "milliseconds",
    "prefill_tps": "tokens per second",
    "missing_metric": "Empty not zero"
  },
  "aggregate_baselines": [
    {
      "id": "llama-cpp-pc-only-14b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "14b",
      "type": "single_pc_group_summary",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false
    },
    {
      "id": "llama-cpp-pc-only-24b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "24b",
      "type": "single_pc_group_summary",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false
    },
    {
      "id": "llama-cpp-pc-only-32b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "32b",
      "type": "single_pc_group_summary",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false
    }
  ]
}
