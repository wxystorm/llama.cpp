{
  "schema_version": 1,
  "experiment": "sharegpt40-nine-baselines-2026-11-13",
  "prepared_on": "2026-11-13",
  "dataset": {
    "name": "ShareGPT40",
    "prompt_groups": [
      128,
      256,
      512,
      1024
    ],
    "prompts_per_group": 10,
    "prompt_ids": "prompt_{group}_{01..10}.txt"
  },
  "models": {
    "14b": "Qwen3-14B-Q4_K_M.gguf",
    "32b": "Qwen3-32B-Q4_K_M.gguf",
    "24b": "Mistral-Small-3.2-24B-Q6_K.gguf"
  },
  "hardware": {
    "pc_cpu": "Intel Core Ultra 7 155H",
    "pc_gpu": "NVIDIA RTX 4050 Laptop GPU 6 GiB",
    "phone_soc": "Snapdragon 8 Elite"
  },
  "runtime_paths": {
    "model_dir": "${MODEL_DIR}",
    "prompt_dir": "${PROMPT_DIR}",
    "rpc_endpoint": "${RPC_ENDPOINT}"
  },
  "runs": [
    {
      "id": "prima-14b",
      "framework": "prima.cpp",
      "model": "14b",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS"
    },
    {
      "id": "prima-32b",
      "framework": "prima.cpp",
      "model": "32b",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS"
    },
    {
      "id": "jupiter-14b",
      "framework": "jupiter",
      "model": "14b",
      "method": "Sequence DP",
      "pc_layers": 24,
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "graph_prebuild": true,
      "window": 2,
      "bench_repeats": 1
    },
    {
      "id": "jupiter-32b",
      "framework": "jupiter",
      "model": "32b",
      "method": "Sequence DP",
      "pc_layers": 52,
      "cpu_layers": 40,
      "pc_gpu_layers": 12,
      "phone_layers": 12,
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "graph_prebuild": true,
      "window": 2,
      "bench_repeats": 1,
      "max_rounds": 1,
      "min_chunk": 96,
      "max_chunk": 128,
      "memory_safety_percent": 5
    },
    {
      "id": "galaxy-14b",
      "framework": "galaxy",
      "model": "14b",
      "mode": "Galaxy",
      "transport": "RANK_LOCAL",
      "galaxy2_layers": 1,
      "collective_tile_tokens": 256,
      "context": 2048,
      "batch": 512,
      "ubatch": 256,
      "threads": 8,
      "final_layer_sp": false
    },
    {
      "id": "ours-14b-g9p1",
      "framework": "ours",
      "model": "14b",
      "method": "fixed region-ring (GPU + Phone)",
      "run_config": "runs/ours-14b-g9p1/run-config.json",
      "recorded_commit": "3e36c984d4991fbf6f19de72d1e19c8cdcb9a027",
      "layout": "G9,P1,G9,P1,G9,P1,G10",
      "planner": "apply-wide",
      "skip_profile": true,
      "xc": 128,
      "xg": 128,
      "xp": 128,
      "batch": 2048,
      "ubatch": 2048,
      "predict": 1,
      "threads": 8,
      "seed": 1234,
      "no_mmap": true,
      "gpu_weight_streaming": true,
      "context_policy": {
        "fixed": null,
        "minimum": 1024,
        "padding": 64,
        "alignment": 256
      }
    },
    {
      "id": "prima-24b",
      "framework": "prima.cpp",
      "model": "24b",
      "model_family": "Mistral Small 3.2",
      "quantization": "Q6_K",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS",
      "run_config": "runs/prima-24b/run-config.json",
      "observed_planner": {
        "k": 1,
        "W": 40,
        "pc_layers": 19,
        "pc_gpu_layers": 9,
        "phone_layers": 21,
        "phone_gpu_layers": 0
      },
      "runs": 40
    },
    {
      "id": "ours-32b-g8p6",
      "framework": "ours",
      "model": "32b",
      "method": "fixed region-ring GPU+HTP",
      "run_config": "runs/ours-32b-g8p6/run-config.json",
      "layout": "G8,P6,G8,P6,G8,P6,G8,P6,G8",
      "planner": "apply-wide",
      "skip_profile": true,
      "plan_chunks": [
        96,
        128
      ],
      "batch": 2048,
      "ubatch": 2048,
      "predict": 1,
      "threads": 8,
      "no_mmap": true,
      "gpu_weight_streaming": true,
      "gpu_bank_force_small_batch": true,
      "drain_first_cycle": true
    },
    {
      "id": "ours-24b-htp",
      "framework": "ours",
      "model": "24b",
      "method": "forced HTP region-ring with independent backend profile",
      "run_config": "runs/ours-24b-htp/run-config.json",
      "layout": "G5,P3,G5,P3,G6,P3,G5,P4,G6",
      "planner": "apply-wide",
      "planning_mode": "independent-backend-profile-then-plan",
      "skip_profile": false,
      "xc": 96,
      "xg": 96,
      "xp": 96,
      "batch": 2048,
      "ubatch": 2048,
      "predict": 1,
      "threads": 8,
      "no_mmap": true,
      "gpu_weight_streaming": true
    }
  ],
  "measurements": {
    "prefill_ms": "milliseconds",
    "prefill_tps": "tokens per second",
    "missing_metric": "Empty not zero"
  },
  "partial_baselines": [
    {
      "id": "pc-only-32b",
      "framework": "llama.cpp / PC-only",
      "model": "32b",
      "execution": "single-PC",
      "kind": "incomplete_reference_baseline",
      "observations": "runs/pc-only-32b/observations.csv",
      "raw_log": "runs/pc-only-32b/256-group-server-log.txt",
      "source": "user-reported measurements and provided server log, 2026-11-13",
      "sample_count": 2,
      "full_sharegpt40_run": false,
      "note": "The 256-group measurement has 266 actual prompt tokens but unspecified prompt index; the 512_01 throughput is reported without a timing log. The runtime settings for this PC-only run were not supplied."
    }
  ]
}
