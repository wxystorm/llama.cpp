{
  "schema_version": 1,
  "experiment": "sharegpt40-ten-baselines-2026-11-13",
  "prepared_on": "2026-11-13",
  "dataset": {
    "name": "ShareGPT40",
    "prompt_groups": [
      0,
      128,
      256,
      512,
      1024
    ],
    "prompts_per_group": 10,
    "prompt_ids": "prompt_{group}_{01..10}.txt",
    "note": "The three Ours server-plan runs each include groups 0/128/256/512/1024, with ten prompts per group. Other ShareGPT40 baselines use groups 128/256/512/1024; Jupiter 24B group 1024 has only six PASS observations. PC-only 2048 observations are separate and excluded from results.csv."
  },
  "models": {
    "14b": "Qwen3-14B-Q4_K_M.gguf",
    "32b": "Qwen3-32B-Q4_K_M.gguf",
    "24b": "Mistral-Small-3.2-24B-Q6_K.gguf"
  },
  "hardware": {
    "pc_cpu": "Intel Core Ultra 7 155H",
    "pc_gpu": "NVIDIA RTX 4050 Laptop GPU 6 GiB",
    "phone_soc": "Snapdragon 8 Elite"
  },
  "runtime_paths": {
    "model_dir": "${MODEL_DIR}",
    "prompt_dir": "${PROMPT_DIR}",
    "rpc_endpoint": "${RPC_ENDPOINT}"
  },
  "runs": [
    {
      "id": "prima-14b",
      "framework": "prima.cpp",
      "model": "14b",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS"
    },
    {
      "id": "prima-32b",
      "framework": "prima.cpp",
      "model": "32b",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS"
    },
    {
      "id": "jupiter-14b",
      "framework": "jupiter",
      "model": "14b",
      "method": "Sequence DP",
      "pc_layers": 24,
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "graph_prebuild": true,
      "window": 2,
      "bench_repeats": 1
    },
    {
      "id": "jupiter-32b",
      "framework": "jupiter",
      "model": "32b",
      "method": "Sequence DP",
      "pc_layers": 52,
      "cpu_layers": 40,
      "pc_gpu_layers": 12,
      "phone_layers": 12,
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "graph_prebuild": true,
      "window": 2,
      "bench_repeats": 1,
      "max_rounds": 1,
      "min_chunk": 96,
      "max_chunk": 128,
      "memory_safety_percent": 5
    },
    {
      "id": "galaxy-14b",
      "framework": "galaxy",
      "model": "14b",
      "mode": "Galaxy",
      "transport": "RANK_LOCAL",
      "galaxy2_layers": 1,
      "collective_tile_tokens": 256,
      "context": 2048,
      "batch": 512,
      "ubatch": 256,
      "threads": 8,
      "final_layer_sp": false
    },
    {
      "id": "ours-14b-server-plan",
      "framework": "ours",
      "model": "14b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-14b-server-plan/run-config.json",
      "layout": "G11,P5,G11,P5,G8",
      "layout_reported": true,
      "layout_source": "user-confirmed alongside SERVER_PROBE logs",
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-14b-server-plan/per-prompt-details.csv"
    },
    {
      "id": "prima-24b",
      "framework": "prima.cpp",
      "model": "24b",
      "model_family": "Mistral Small 3.2",
      "quantization": "Q6_K",
      "context": 4096,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS",
      "run_config": "runs/prima-24b/run-config.json",
      "observed_planner": {
        "k": 1,
        "W": 40,
        "pc_layers": 19,
        "pc_gpu_layers": 9,
        "phone_layers": 21,
        "phone_gpu_layers": 0
      },
      "runs": 40
    },
    {
      "id": "ours-32b-server-plan",
      "framework": "ours",
      "model": "32b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-32b-server-plan/run-config.json",
      "layout": "G7,P4,G7,P4,G8,P5,G7,P4,G7,P4,G7",
      "layout_reported": true,
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-32b-server-plan/per-prompt-details.csv",
      "layout_source": "user-confirmed follow-up to 2026-11-17 SERVER_PROBE data"
    },
    {
      "id": "ours-24b-server-plan",
      "framework": "ours",
      "model": "24b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-24b-server-plan/run-config.json",
      "layout": "G5,P3,G5,P3,G6,P3,G5,P4,G6",
      "layout_reported": true,
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-24b-server-plan/per-prompt-details.csv",
      "layout_source": "user-confirmed follow-up to 2026-11-17 SERVER_PROBE data"
    },
    {
      "id": "jupiter-24b",
      "framework": "jupiter",
      "model": "24b",
      "method": "Sequence DP",
      "run_config": "runs/jupiter-24b/run-config.json",
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "pc_layers": 32,
      "cpu_layers": 24,
      "graph_prebuild": false,
      "min_chunk": 96,
      "max_chunk": 128,
      "bench_repeats": 1,
      "expected_prompts": 40,
      "observed_passes": 36,
      "complete": false
    }
  ],
  "measurements": {
    "prefill_ms": "milliseconds",
    "prefill_tps": "tokens per second",
    "missing_metric": "Empty not zero"
  },
  "partial_baselines": [
    {
      "id": "pc-only-32b",
      "framework": "llama.cpp / PC-only",
      "model": "32b",
      "execution": "single-PC",
      "kind": "incomplete_reference_baseline",
      "observations": "runs/pc-only-32b/observations.csv",
      "raw_log": "runs/pc-only-32b/256-group-server-log.txt",
      "source": "Earlier 256 and 512 baseline references plus a 2048-group minimum from the 2026-11-15 uploaded logfile",
      "sample_count": 3,
      "full_sharegpt40_run": false,
      "note": "256: 21.58 tok/s (prompt index unknown); 512_01: user reported 32.9 tok/s; 2048_02: selected minimum 17.61 tok/s from the newest log. None represents a group Top-5 or full 40-prompt result.",
      "additional_run_config": "runs/pc-only-32b/2048-min-run-config.json"
    },
    {
      "id": "pc-only-14b",
      "framework": "llama.cpp / PC-only",
      "model": "14b",
      "execution": "single-PC",
      "kind": "incomplete_reference_baseline",
      "full_sharegpt40_run": false,
      "sample_count": 1,
      "observations": "runs/pc-only-14b/observations.csv",
      "run_config": "runs/pc-only-14b/2048-min-run-config.json",
      "source": "selected lowest Prefill TPS from 2 completed 14B log measurements, 2026-11-15",
      "note": "2048-group 66.89 tok/s; exact prompt filename and launch flags are not present for the selected record."
    }
  ],
  "aggregate_baselines": [
    {
      "id": "llama-cpp-pc-only-14b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "14b",
      "type": "aggregate_only_group_means",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false,
      "source": "User-supplied screenshot of mean_tok/s by model and group, 2026-11-16",
      "note": "No per-prompt measurements, per-group median, or mean prefill latency were supplied. Older partial PC-only observations remain separate."
    },
    {
      "id": "llama-cpp-pc-only-24b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "24b",
      "type": "aggregate_only_group_means",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false,
      "source": "User-supplied screenshot of mean_tok/s by model and group, 2026-11-16",
      "note": "No per-prompt measurements, per-group median, or mean prefill latency were supplied. Older partial PC-only observations remain separate."
    },
    {
      "id": "llama-cpp-pc-only-32b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "32b",
      "type": "aggregate_only_group_means",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false,
      "source": "User-supplied screenshot of mean_tok/s by model and group, 2026-11-16",
      "note": "No per-prompt measurements, per-group median, or mean prefill latency were supplied. Older partial PC-only observations remain separate."
    }
  ]
}
