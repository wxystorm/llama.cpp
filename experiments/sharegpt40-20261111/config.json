{
  "schema_version": 1,
  "experiment": "sharegpt40-ten-baselines-2026-11-13",
  "prepared_on": "2026-11-13",
  "dataset": {
    "name": "ShareGPT40",
    "prompt_groups": [
      0,
      128,
      256,
      512,
      1024
    ],
    "prompts_per_group": 10,
    "prompt_ids": "prompt_{group}_{01..10}.txt",
    "note": "Ours 14B/24B/32B, Galaxy 14B, and Prima.cpp 24B/32B cover groups 0/128/256/512/1024. Prima.cpp 14B has a group-0 summary (10 prompts) and 40 existing prompt-level records. Jupiter 24B has user-reported remeasured group means for all 5 groups, 10 prompts each (50 total); new per-prompt data was not provided. Old 36 Jupiter 24B prompt-level records are superseded due to a prefix issue. The active Jupiter 32B L52 offline-DP run (2026-11-26) and Ours 32B optimized server-plan run (2026-11-27) both contain all 50 per-prompt records. Prompt filenames match; actual token counts differ."
  },
  "models": {
    "14b": "Qwen3-14B-Q4_K_M.gguf",
    "32b": "Qwen3-32B-Q4_K_M.gguf",
    "24b": "Mistral-Small-3.2-24B-Q6_K.gguf"
  },
  "hardware": {
    "pc_cpu": "Intel Core Ultra 7 155H",
    "pc_gpu": "NVIDIA RTX 4050 Laptop GPU 6 GiB",
    "phone_soc": "Snapdragon 8 Elite"
  },
  "runtime_paths": {
    "model_dir": "${MODEL_DIR}",
    "prompt_dir": "${PROMPT_DIR}",
    "rpc_endpoint": "${RPC_ENDPOINT}"
  },
  "runs": [
    {
      "id": "prima-14b",
      "framework": "prima.cpp",
      "model": "14b",
      "context": 2048,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS",
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      }
    },
    {
      "id": "prima-32b",
      "framework": "prima.cpp",
      "model": "32b",
      "context": 2048,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS",
      "runs": 50,
      "run_config": "runs/prima-32b/run-config.json",
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      }
    },
    {
      "id": "jupiter-14b",
      "framework": "jupiter",
      "model": "14b",
      "method": "Sequence DP",
      "pc_layers": 24,
      "context": 2048,
      "batch": 2048,
      "ubatch": 128,
      "graph_prebuild": true,
      "window": 2,
      "bench_repeats": 1
    },
    {
      "id": "jupiter-32b",
      "framework": "jupiter",
      "model": "32b",
      "method": "Sequence DP (offline)",
      "pc_layers": 52,
      "cpu_layers": 36,
      "pc_gpu_layers": 16,
      "phone_layers": 12,
      "sessions": 4,
      "context": 2048,
      "batch": 2048,
      "backend": "resident-server",
      "run_mode": "autonomous",
      "bench_repeats": 1,
      "min_chunk": 128,
      "warmup": false,
      "profile": "OFFLINE_SHARED",
      "run_config": "runs/jupiter-32b/run-config.json",
      "per_prompt_details": "runs/jupiter-32b/per-prompt-details.csv",
      "source_received_date": "2026-11-26",
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "PHONE_SUITE result logs"
    },
    {
      "id": "galaxy-14b",
      "framework": "galaxy",
      "model": "14b",
      "mode": "Galaxy",
      "transport": "RANK_LOCAL",
      "galaxy2_layers": 1,
      "collective_tile_tokens": 256,
      "context": 2048,
      "batch": 512,
      "ubatch": 256,
      "threads": 8,
      "final_layer_sp": false,
      "supplemental_group0_config": "runs/galaxy-14b-group0/run-config.json",
      "supplemental_group0_details": "runs/galaxy-14b-group0/per-prompt-details.csv",
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      }
    },
    {
      "id": "ours-14b-server-plan",
      "framework": "ours",
      "model": "14b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-14b-server-plan/run-config.json",
      "layout": "G11,P5,G11,P5,G8",
      "layout_reported": true,
      "layout_source": "user-confirmed alongside SERVER_PROBE logs",
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-14b-server-plan/per-prompt-details.csv"
    },
    {
      "id": "prima-24b",
      "framework": "prima.cpp",
      "model": "24b",
      "model_family": "Mistral Small 3.2",
      "quantization": "Q6_K",
      "context": 2048,
      "predict": 32,
      "batch": 512,
      "ubatch": 512,
      "threads": 8,
      "planner": "HiGHS",
      "run_config": "runs/prima-24b/run-config.json",
      "runs": 50,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      }
    },
    {
      "id": "ours-32b-server-plan",
      "framework": "ours",
      "model": "32b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-32b-server-plan/run-config.json",
      "layout": "G7,P4,G7,P4,G8,P5,G7,P4,G7,P4,G7",
      "layout_reported": true,
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-32b-server-plan/per-prompt-details.csv",
      "layout_source": "Fixed layout from preceding 2026-11-27 experiment setup",
      "source_received_date": "2026-11-27",
      "context": 2048,
      "batch": 2048,
      "ubatch": 2048,
      "no_mmap": true,
      "session_scratch_reuse": true,
      "locked_xc_dedup": true,
      "expected_source_commit": "a35aa25feb4a1f6958420dc0810d6eb495e795fc"
    },
    {
      "id": "ours-24b-server-plan",
      "framework": "ours",
      "model": "24b",
      "method": "server-probe per-prompt plan",
      "run_config": "runs/ours-24b-server-plan/run-config.json",
      "layout": "G5,P3,G5,P3,G6,P3,G5,P4,G6",
      "layout_reported": true,
      "planner": "SERVER_PROBE",
      "cache_prompt_tokens": 0,
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "metrics_source": "SERVER_PROBE prefill_ms and tps",
      "per_prompt_chunks": "runs/ours-24b-server-plan/per-prompt-details.csv",
      "layout_source": "user-confirmed follow-up to 2026-11-17 SERVER_PROBE data"
    },
    {
      "id": "jupiter-24b",
      "framework": "jupiter",
      "model": "24b",
      "method": "Sequence DP",
      "aggregation": "group_mean_only",
      "source": "user-reported remeasurement, 2026-11-18",
      "remeasurement_reason": "24B prefix issue",
      "group_counts": {
        "0": 10,
        "128": 10,
        "256": 10,
        "512": 10,
        "1024": 10
      },
      "reported_prompts": 50,
      "group_means_complete": true,
      "new_per_prompt_data_available": false,
      "legacy_run_config": "runs/jupiter-24b/run-config.json",
      "legacy_per_prompt_details": "runs/jupiter-24b/per-prompt-details.csv"
    }
  ],
  "measurements": {
    "prefill_ms": "milliseconds",
    "prefill_tps": "tokens per second",
    "missing_metric": "Empty not zero"
  },
  "aggregate_baselines": [
    {
      "id": "llama-cpp-pc-only-14b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "14b",
      "type": "single_pc_group_summary",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false
    },
    {
      "id": "llama-cpp-pc-only-24b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "24b",
      "type": "single_pc_group_summary",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false
    },
    {
      "id": "llama-cpp-pc-only-32b-sharegpt50",
      "framework": "llama.cpp-pc-only",
      "model": "32b",
      "type": "single_pc_group_summary",
      "groups": [
        0,
        128,
        256,
        512,
        1024
      ],
      "reported_runs_per_group": 10,
      "group_summary": "runs/llama-cpp-pc-only-sharegpt50/group-means.csv",
      "run_config": "runs/llama-cpp-pc-only-sharegpt50/run-config.json",
      "included_in_group_summary": true,
      "included_in_results_csv": false
    }
  ],
  "comparison_32b": {
    "date": "2026-11-27",
    "file": "32b-prefill-comparison-20261127.csv",
    "previous_ours_ref": "91fe6a6c65bad073749ad1ab75a1fd6bc1380501",
    "mean_definition": "Arithmetic mean of per-prompt TPS; trimmed mean drops exactly one minimum-TPS observation per group per method",
    "all_definition": "Mean across five equally sized groups; weighted TPS uses all raw tokens divided by all raw Prefill time",
    "token_alignment": "Match by prompt filename; not identical token counts between Jupiter and Ours"
  }
}
